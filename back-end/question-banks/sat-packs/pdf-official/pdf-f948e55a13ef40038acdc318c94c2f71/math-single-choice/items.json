      "options": [
        {
          "id": "choice-a",
          "content": [
            {
              "type": "markdown",
              "text": "$$g ( x )=\\frac{7}{2} x 3$$"
            }
          ]
        },
        {
          "id": "choice-b",
          "content": [
            {
              "type": "markdown",
              "text": "$$g ( x )=7 x \\frac{3}{2}$$"
            }
          ]
        },
        {
          "id": "choice-c",
          "content": [
            {
              "type": "markdown",
              "text": "$$g ( x )=7 x 3+2$$"
            }
          ]
        },
        {
          "id": "choice-d",
          "content": [
            {
              "type": "markdown",
              "text": "$$g ( x )=7 x 3 - 2$$"
            }
          ]
        }
      ]
