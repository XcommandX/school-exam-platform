      "options": [
        {
          "id": "choice-a",
          "content": [
            {
              "type": "markdown",
              "text": "It is plausible that the actual mean number of books employees at the company read last year\nis less than 5.7."
            }
          ]
        },
        {
          "id": "choice-b",
          "content": [
            {
              "type": "markdown",
              "text": "It is plausible that the actual mean number of books employees at the company read last year is\nbetween 5.7 and 7.9."
            }
          ]
        },
        {
          "id": "choice-c",
          "content": [
            {
              "type": "markdown",
              "text": "It is plausible that every employee at the company read between 6.8 and 10.1 books last year."
            }
          ]
        },
        {
          "id": "choice-d",
          "content": [
            {
              "type": "markdown",
              "text": "It is plausible that the actual mean number of books employees at the company read last year\nis greater than 7.9."
            }
          ]
        }
      ]
