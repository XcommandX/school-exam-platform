      "prompt": [
        {
          "type": "markdown",
          "text": "On a certain day in June, the lowest recorded wind speed in a town was 5 miles per hour (mph)\nand the highest recorded wind speed was 14 mph. Which inequality is true for all values of $w$,\nwhere $w$ represents any wind speed, in mph, recorded in the town on this day?"
        }
      ],
      "source": {
        "kind": "editable-pdf-source",
        "sourceSetId": "pdf-6fe105fb1ac64abfb655248d18aaff21",
        "sourceQuestionId": "m1-q2"
      },
      "options": [
        {
          "id": "choice-a",
          "content": [
            {
              "type": "markdown",
              "text": "$$w \\le 5$$"
            }
          ]
        },
        {
          "id": "choice-b",
          "content": [
            {
              "type": "markdown",
              "text": "$$w \\le 9$$"
            }
          ]
        },
        {
          "id": "choice-c",
          "content": [
            {
              "type": "markdown",
              "text": "$$w \\ge 14$$"
            }
          ]
        },
        {
          "id": "choice-d",
          "content": [
            {
              "type": "markdown",
              "text": "$$5 \\le w \\le 14$$"
            }
          ]
        }
      ]
    },
