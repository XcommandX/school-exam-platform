      "prompt": [
        {
          "type": "markdown",
          "text": "For a training program, Juan rides his bike at an average rate of 5.7 minutes per mile. Which\nfunction $m$ models the number of minutes it will take Juan to ride $x$ miles at this rate?"
        }
      ],
      "source": {
        "kind": "editable-pdf-source",
        "sourceSetId": "pdf-2ba4e6d542404c68800102f4c673583e",
        "sourceQuestionId": "m1-q7"
      },
      "options": [
        {
          "id": "choice-a",
          "content": [
            {
              "type": "markdown",
              "text": "$$m ( x )=x/5.7$$"
            }
          ]
        },
        {
          "id": "choice-b",
          "content": [
            {
              "type": "markdown",
              "text": "$$m ( x )=x+5.7$$"
            }
          ]
        },
        {
          "id": "choice-c",
          "content": [
            {
              "type": "markdown",
              "text": "$$m ( x )=x - 5.7$$"
            }
          ]
        },
        {
          "id": "choice-d",
          "content": [
            {
              "type": "markdown",
              "text": "$$m ( x )=5.7 x$$"
            }
          ]
        }
      ]
    },
