      "prompt": [
        {
          "type": "markdown",
          "text": "A space probe uses a square-shaped solar sail to move through space. The side length of the solar\nsail is $8.61w$ meters, where $w$ is the width, in meters, of the space probe. Which equation gives\nthe area A, in square meters, of the solar sail?"
        }
      ],
      "source": {
        "kind": "editable-pdf-source",
        "sourceSetId": "pdf-622a4f75b72949119b9109a41e3fccb1",
        "sourceQuestionId": "m1-q13"
      },
      "options": [
        {
          "id": "choice-a",
          "content": [
            {
              "type": "markdown",
              "text": "$$A=(w+8.61)(w+8.61)$$"
            }
          ]
        },
        {
          "id": "choice-b",
          "content": [
            {
              "type": "markdown",
              "text": "$$A=(4)(8.61w)$$"
            }
          ]
        },
        {
          "id": "choice-c",
          "content": [
            {
              "type": "markdown",
              "text": "$$A=(8.61w)(8.61w)$$"
            }
          ]
        },
        {
          "id": "choice-d",
          "content": [
            {
              "type": "markdown",
              "text": "$$A=(8.61/w)(8.61/w)$$"
            }
          ]
        }
      ]
    },
