    {
      "itemId": "sat:item:pdf-70cb861515e54db2a30f89c462a5f986-m2-q14",
      "itemRevision": 1,
      "answer": {
        "status": "needs-review",
        "type": "single-choice",
        "optionId": "choice-d"
