      "prompt": [
        {
          "type": "markdown",
          "text": "All the sidewalk paving stones in a neighborhood are rectangular. The length of each of these\npaving stones is 41 centimeters greater than the width. Which equation gives the area $A$, in square\ncentimeters, of a sidewalk paving stone in terms of the width $w$, in centimeters, of that paving\nstone?"
        }
      ],
      "source": {
        "kind": "editable-pdf-source",
        "sourceSetId": "pdf-98ab9fd1c3274aa4b3669c900f2beb27",
        "sourceQuestionId": "m1-q6"
      },
      "options": [
        {
          "id": "choice-a",
          "content": [
            {
              "type": "markdown",
              "text": "$$A=( w ) ( w/41 )$$"
            }
          ]
        },
        {
          "id": "choice-b",
          "content": [
            {
              "type": "markdown",
              "text": "$$A=( w ) ( 41 w )$$"
            }
          ]
        },
        {
          "id": "choice-c",
          "content": [
            {
              "type": "markdown",
              "text": "$$A=( w ) ( w+41 )$$"
            }
          ]
        },
        {
          "id": "choice-d",
          "content": [
            {
              "type": "markdown",
              "text": "$$A=w 2$$"
            }
          ]
        }
      ]
    },
