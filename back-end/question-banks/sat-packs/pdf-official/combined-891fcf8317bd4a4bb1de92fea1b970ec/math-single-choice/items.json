        "sourceQuestionId": "m1-q5"
      },
      "options": [
        {
          "id": "choice-a",
          "content": [
            {
              "type": "markdown",
              "text": "$$y=( \\frac{1}{9} ) ( x+3 )+1$$"
            }
          ]
        },
        {
          "id": "choice-b",
          "content": [
            {
              "type": "markdown",
              "text": "$$y=( \\frac{1}{9} ) ( x - 3 )+1$$"
            }
          ]
        },
        {
          "id": "choice-c",
          "content": [
            {
              "type": "markdown",
              "text": "$$y=3 ( \\frac{1}{9} ) x+1$$"
