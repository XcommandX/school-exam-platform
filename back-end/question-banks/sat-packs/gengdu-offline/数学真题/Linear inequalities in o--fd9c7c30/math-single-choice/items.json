          "content": [
            {
              "type": "markdown",
              "text": "*p* &gt; 0.20(300-36), where *p*$\\le$ 150"
            }
          ]
        },
        {
          "id": "choice-b",
          "content": [
            {
              "type": "markdown",
              "text": "*p* &gt; 0.20(300+36), where *p*$\\le$ 150"
            }
          ]
        },
        {
          "id": "choice-c",
          "content": [
            {
              "type": "markdown",
              "text": "*p* -36 &gt; 0.20(300), where *p*$\\le$ 150"
