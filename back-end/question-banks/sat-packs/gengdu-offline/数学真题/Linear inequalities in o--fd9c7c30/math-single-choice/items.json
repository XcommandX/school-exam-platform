              "text": "2*x* $\\le$ *s* $\\le$"
            }
          ]
        },
        {
          "id": "choice-b",
          "content": [
            {
              "type": "markdown",
              "text": "$\\frac{2}{0.11}x\\le s\\le\\frac{3}{0.11}x$"
            }
          ]
        },
        {
          "id": "choice-c",
          "content": [
            {
              "type": "markdown",
              "text": "3*x* $\\le$ *s* $\\le$"
            }
