      "prompt": [
        {
          "type": "markdown",
          "text": "Adam’s school is a 20-minute walk or a 5-minute bus ride away from his house. The bus runs once every 30 minutes, and the number of minutes, *w*, that Adam waits for the bus varies between 0 and 30. Which of the following inequalities gives the values of *w* for which it would be faster for Adam to walk to school?"
        }
      ],
      "source": {
        "kind": "gengdu-export",
        "sourceSetId": "gengdu-offline-fd9c7c30ddc9498aa08e7db728f23df9",
        "sourceQuestionId": "8900295",
        "url": "https://gengdu.shanmaostar.com"
      },
      "options": [
        {
          "id": "choice-a",
          "content": [
            {
              "type": "markdown",
              "text": "*w* -5 &lt; 20"
            }
          ]
        },
        {
          "id": "choice-b",
          "content": [
            {
              "type": "markdown",
              "text": "*w* -5 &gt; 20"
            }
          ]
        },
        {
          "id": "choice-c",
          "content": [
            {
              "type": "markdown",
              "text": "*w* +5 &lt; 20"
            }
          ]
        },
        {
          "id": "choice-d",
          "content": [
            {
              "type": "markdown",
              "text": "*w* +5 &gt; 20"
            }
          ]
        }
      ]
    },
    {
      "id": "sat:item:gengdu-gengdu-offline-fd9c7c30ddc9498aa08e7db728f23df9-8900296",
      "revision": 1,
