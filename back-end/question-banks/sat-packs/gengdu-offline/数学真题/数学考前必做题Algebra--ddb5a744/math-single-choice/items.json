      "prompt": [
        {
          "type": "markdown",
          "text": "The cost to rent a bus from Company X is \\$950 for the first 2 hours and an additional \\$50 per hour for each hour after the first 2 hours. If the total cost to rent the bus from Company X for t hours, where t&gt; 2, is \\$1,150, which equation represents this situation?"
        }
      ],
      "source": {
        "kind": "gengdu-export",
        "sourceSetId": "gengdu-offline-ddb5a744241e422a8cd312bc6343d862",
        "sourceQuestionId": "8257529",
        "url": "https://gengdu.shanmaostar.com"
      },
      "options": [
        {
          "id": "choice-a",
          "content": [
            {
              "type": "markdown",
              "text": "950(t-2)+50t=1,150"
            }
          ]
        },
        {
          "id": "choice-b",
          "content": [
            {
              "type": "markdown",
              "text": "950(2t)+50t =1,150"
            }
          ]
        },
        {
          "id": "choice-c",
          "content": [
            {
              "type": "markdown",
              "text": "950+50(t-2)= 1,150"
            }
          ]
        },
        {
          "id": "choice-d",
          "content": [
            {
              "type": "markdown",
              "text": "950+50(2t)=1,150"
            }
          ]
        }
      ]
