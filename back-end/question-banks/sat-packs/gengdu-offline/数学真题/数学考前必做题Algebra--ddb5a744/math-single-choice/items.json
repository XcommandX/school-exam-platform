      "source": {
        "kind": "gengdu-export",
        "sourceSetId": "gengdu-offline-ddb5a744241e422a8cd312bc6343d862",
        "sourceQuestionId": "8257287",
        "url": "https://gengdu.shanmaostar.com"
      },
      "options": [
        {
          "id": "choice-a",
          "content": [
            {
              "type": "markdown",
              "text": "*f*(*n*) = 14*n* + 175"
            }
          ]
        },
        {
          "id": "choice-b",
          "content": [
            {
              "type": "markdown",
              "text": "*f*(*n*)= 14*n* + 525"
