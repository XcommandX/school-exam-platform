          "content": [
            {
              "type": "markdown",
              "text": "$$1.75/9c+2.25/8d=12$$"
            }
          ]
        },
        {
          "id": "choice-b",
          "content": [
            {
              "type": "markdown",
              "text": "$$2.25/8c+1.75/9d=12$$"
            }
          ]
        },
        {
          "id": "choice-c",
          "content": [
            {
              "type": "markdown",
              "text": "$$9/1.75c+8/2.25d=12$$"
            }
          ]
        },
        {
