      "content": [],
      "prompt": [
        {
          "type": "markdown",
          "text": "The gas mileage of a certain car is 35 miles per gallon when driven on the highway. If the car\nbegins with 10 gallons of gas in the tank, which function predicts the amount of gas remaining in\nthe tank, $f ( d )$, after the car is driven $d$ miles on the highway?"
        }
      ],
      "source": {
        "kind": "editable-pdf-source",
        "sourceSetId": "pdf-ad2e25df47df4a2283d42573d8f62e64",
        "sourceQuestionId": "m2-q5"
      },
      "options": [
        {
          "id": "choice-a",
          "content": [
            {
              "type": "markdown",
              "text": "$$f ( d )=d/35 - 10$$"
            }
          ]
        },
        {
          "id": "choice-b",
          "content": [
            {
              "type": "markdown",
              "text": "$$f ( d )=d - 10$$"
            }
          ]
        },
        {
          "id": "choice-c",
          "content": [
            {
              "type": "markdown",
              "text": "$$f ( d )=10 - d/35$$"
            }
          ]
        },
        {
          "id": "choice-d",
          "content": [
            {
              "type": "markdown",
              "text": "$$f ( d )=10 - d$$"
            }
          ]
        }
      ]
    },
