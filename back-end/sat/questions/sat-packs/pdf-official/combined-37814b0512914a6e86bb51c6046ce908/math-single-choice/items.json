      "options": [
        {
          "id": "choice-a",
          "content": [
            {
              "type": "markdown",
              "text": "$$f+s \\le 100$$"
            }
          ]
        },
        {
          "id": "choice-b",
          "content": [
            {
              "type": "markdown",
              "text": "$$2 f+5 s \\ge 100$$"
            }
          ]
        },
        {
          "id": "choice-c",
          "content": [
            {
              "type": "markdown",
              "text": "$$5 f+s \\ge 100$$"
            }
          ]
        },
        {
          "id": "choice-d",
          "content": [
            {
              "type": "markdown",
              "text": "$$5 f+2 s \\le 100$$"
            }
          ]
        }
      ]
