      "prompt": [
        {
          "type": "markdown",
          "text": "The growth of the number of bacteria in a certain population is modeled by a function that\nincreases exponentially over time. Which of the following could describe how the number of\nbacteria in the population changes each hour?"
        }
      ],
      "source": {
        "kind": "editable-pdf-source",
        "sourceSetId": "pdf-1541a209d6214233851e46a4a8d7ad46",
        "sourceQuestionId": "m1-q5"
      },
      "options": [
        {
          "id": "choice-a",
          "content": [
            {
              "type": "markdown",
              "text": "Each hour, the number of bacteria in the population is $16\\%$ greater than it was the previous\nhour."
            }
          ]
        },
        {
          "id": "choice-b",
          "content": [
            {
              "type": "markdown",
              "text": "Each hour, the number of bacteria in the population is 1,600 greater than was the previous\nhour."
            }
          ]
        },
        {
          "id": "choice-c",
          "content": [
            {
              "type": "markdown",
              "text": "Each hour, the number of bacteria in the population is 1,600 less than it was the previous hour."
            }
          ]
        },
        {
          "id": "choice-d",
          "content": [
            {
              "type": "markdown",
              "text": "Each hour, the number of bacteria in the population is $16\\%$ less than it was the previous hour."
            }
          ]
        }
