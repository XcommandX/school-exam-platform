      "prompt": [
        {
          "type": "markdown",
          "text": "For the linear function $f$, the graph of $y=f ( x )$ in the $xy$-plane has a slope of $\\frac{1}{3}$ and passes\nthrough the point $( 0 , 7 )$. Which equation defines $f$?"
        }
      ],
      "source": {
        "kind": "editable-pdf-source",
        "sourceSetId": "pdf-e9935a1ebb2947b9946bf54b5babdb5c",
        "sourceQuestionId": "m1-q3"
      },
      "options": [
        {
          "id": "choice-a",
          "content": [
            {
              "type": "markdown",
              "text": "$$f ( x )=\\frac{1}{3} x+7$$"
            }
          ]
        },
        {
          "id": "choice-b",
          "content": [
            {
              "type": "markdown",
              "text": "$$f ( x )=\\frac{1}{3} x+\\frac{1}{7}$$"
            }
          ]
        },
        {
          "id": "choice-c",
          "content": [
            {
              "type": "markdown",
              "text": "$$f ( x )=\\frac{1}{3} x - \\frac{7}{3}$$"
            }
          ]
        },
        {
          "id": "choice-d",
          "content": [
            {
              "type": "markdown",
              "text": "$$f ( x )=\\frac{1}{3} x - 7$$"
            }
          ]
        }
      ]
    },
