        "kind": "editable-pdf-source",
        "sourceSetId": "pdf-94f5afab576446fd887a258355cfac7b",
        "sourceQuestionId": "m1-q6"
      },
      "options": [
        {
          "id": "choice-a",
          "content": [
            {
              "type": "markdown",
              "text": "$$y=9 x+8$$"
            }
          ]
        },
        {
          "id": "choice-b",
          "content": [
            {
              "type": "markdown",
              "text": "$$y=9 x - 8$$"
            }
          ]
        },
        {
          "id": "choice-c",
          "content": [
            {
              "type": "markdown",
              "text": "$$y=9 ( x+8 )$$"
