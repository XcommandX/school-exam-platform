    {
      "itemId": "sat:item:pdf-f0cf803f5ad64256919cc189c82a25a7-m2-q14",
      "itemRevision": 1,
      "answer": {
        "status": "needs-review",
        "type": "single-choice",
        "optionId": "choice-c"
