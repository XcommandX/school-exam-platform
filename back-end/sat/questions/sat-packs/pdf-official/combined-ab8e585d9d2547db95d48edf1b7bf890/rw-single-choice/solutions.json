    {
      "itemId": "sat:item:pdf-074e5ff5d7204bec8825eaa67a1f1a9e-m2-q13",
      "itemRevision": 1,
      "answer": {
        "status": "needs-review",
        "type": "single-choice",
        "optionId": "choice-b"
