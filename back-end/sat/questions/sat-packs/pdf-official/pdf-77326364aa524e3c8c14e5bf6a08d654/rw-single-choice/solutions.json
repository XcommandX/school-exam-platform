    {
      "itemId": "sat:item:pdf-77326364aa524e3c8c14e5bf6a08d654-m1-q7",
      "itemRevision": 1,
      "answer": {
        "status": "needs-review",
        "type": "single-choice",
        "optionId": "choice-a"
