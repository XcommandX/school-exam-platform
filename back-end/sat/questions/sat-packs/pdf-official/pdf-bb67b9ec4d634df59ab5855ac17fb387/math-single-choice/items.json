              "type": "markdown",
              "text": "$$BC=71/n$$"
            }
          ]
        },
        {
          "id": "choice-b",
          "content": [
            {
              "type": "markdown",
              "text": "$$BC=71n$$"
            }
          ]
        },
        {
          "id": "choice-c",
          "content": [
            {
              "type": "markdown",
              "text": "The measure of angle $Z$ is $52/n$ degrees."
