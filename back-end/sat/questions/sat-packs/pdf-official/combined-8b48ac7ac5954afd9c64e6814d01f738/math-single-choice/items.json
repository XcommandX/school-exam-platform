          "id": "choice-a",
          "content": [
            {
              "type": "markdown",
              "text": "$$A=( w+8.89 ) ( w+8.89 )$$"
            }
          ]
        },
        {
          "id": "choice-b",
          "content": [
            {
              "type": "markdown",
              "text": "$$A=( 4 ) ( 8.89 w )$$"
            }
          ]
        },
        {
          "id": "choice-c",
          "content": [
            {
              "type": "markdown",
              "text": "$$A=( 8.89 w ) ( 8.89 w )$$"
            }
          ]
        },
        {
          "id": "choice-d",
          "content": [
            {
              "type": "markdown",
              "text": "$$A=( 8.89/w ) ( 8.89/w )$$"
            }
          ]
        }
      ]
