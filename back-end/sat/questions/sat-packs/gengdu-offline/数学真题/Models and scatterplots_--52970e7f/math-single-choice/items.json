          ]
        },
        {
          "id": "choice-c",
          "content": [
            {
              "type": "markdown",
              "text": "Every 10 years between 1940 and 2010, the average increase in minimum wage was 0.096 dollars."
            }
          ]
        },
        {
          "id": "choice-d",
          "content": [
            {
              "type": "markdown",
              "text": "Every 10 years between 1940 and 2010, the average increase in minimum wage was 0.488 dollars."
            }
          ]
        }
      ]
