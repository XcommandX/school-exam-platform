        "url": "https://gengdu.shanmaostar.com"
      },
      "options": [
        {
          "id": "choice-a",
          "content": [
            {
              "type": "markdown",
              "text": "$\\frac{29m}{4k}$"
            }
          ]
        },
        {
          "id": "choice-b",
          "content": [
            {
              "type": "markdown",
              "text": "$\\frac{29k}{4m}$"
            }
          ]
        },
        {
          "id": "choice-c",
          "content": [
            {
              "type": "markdown",
              "text": "$\\frac{1,044m}{k}$"
