      "prompt": [
        {
          "type": "markdown",
          "text": "One gallon of sealant costs \\$23 and will cover 250 square feet of a surface. A deck has a total surface area of d square feet. which equation represents the cost c, in dollars, of the sealant needed to cover the deck twice?"
        }
      ],
      "source": {
        "kind": "gengdu-export",
        "sourceSetId": "gengdu-offline-fcc8fa63d892489dabcdd693691dd7a6",
        "sourceQuestionId": "6081441",
        "url": "https://gengdu.shanmaostar.com"
      },
      "options": [
        {
          "id": "choice-a",
          "content": [
            {
              "type": "markdown",
              "text": "$c=\\frac{250d}{23}$"
            }
          ]
        },
        {
          "id": "choice-b",
          "content": [
            {
              "type": "markdown",
              "text": "$c=\\frac{500d}{23}$"
            }
          ]
        },
        {
          "id": "choice-c",
          "content": [
            {
              "type": "markdown",
              "text": "$c=23\\left(\\frac{d}{125}\\right)$"
            }
          ]
        },
        {
          "id": "choice-d",
          "content": [
            {
              "type": "markdown",
              "text": "$c=23\\left(\\frac{d}{250}\\right)$"
            }
          ]
        }
      ]
    },
    {
      "id": "sat:item:gengdu-gengdu-offline-fcc8fa63d892489dabcdd693691dd7a6-6081442",
      "revision": 1,
