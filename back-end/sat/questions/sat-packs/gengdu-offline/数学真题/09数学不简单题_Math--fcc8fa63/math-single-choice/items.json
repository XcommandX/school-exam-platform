      "content": [],
      "prompt": [
        {
          "type": "markdown",
          "text": "A geologist estimates that the volume of a boulder is greater than 14.6 cubic feet but less than 18.6 cubic feet. The geologist alsoestimates that the boulder weighs 160 pounds per cubic foot volume. Which inequality represents this situation, where x representsthe estimated total weight, in pounds, of the boulder?"
        }
      ],
      "source": {
        "kind": "gengdu-export",
        "sourceSetId": "gengdu-offline-fcc8fa63d892489dabcdd693691dd7a6",
        "sourceQuestionId": "6081438",
        "url": "https://gengdu.shanmaostar.com"
      },
      "options": [
        {
          "id": "choice-a",
          "content": [
            {
              "type": "markdown",
              "text": "$160-18.6\\lt x\\lt 160-14.6$"
            }
          ]
        },
        {
          "id": "choice-b",
          "content": [
            {
              "type": "markdown",
              "text": "$160+14.6\\lt x\\lt 160+18.6$"
            }
          ]
        },
        {
          "id": "choice-c",
          "content": [
            {
              "type": "markdown",
              "text": "$160\\left(14.6\\right)\\lt x\\lt 160\\left(18.6\\right)$"
            }
          ]
        },
        {
          "id": "choice-d",
          "content": [
            {
              "type": "markdown",
              "text": "$\\frac{160}{18.6}\\lt x\\lt \\frac{160}{14.6}$"
            }
          ]
        }
      ]
    },
    {
      "id": "sat:item:gengdu-gengdu-offline-fcc8fa63d892489dabcdd693691dd7a6-6081440",
