      "prompt": [
        {
          "type": "markdown",
          "text": "For a certain position, an employer offers an hourly wage of \\$16.00 at the start of employment. One year after the start of employment, the hourly wage is increased by 9% of the hourly wage at the start of employment. For the next five years, at the end of every 6-month interval, the hourly wage is increased by 3% of the hourly wage at the end of the previous 6-month interval. Which of the following functions *H* models the hourly wage, in dollars, x years after the start of employment,where 1≤x≤6?"
        }
      ],
      "source": {
        "kind": "gengdu-export",
        "sourceSetId": "gengdu-offline-5b0c28c27c7443be8ae0a8e7c491fd5b",
        "sourceQuestionId": "6081395",
        "url": "https://gengdu.shanmaostar.com"
      },
      "options": [
        {
          "id": "choice-a",
          "content": [
            {
              "type": "markdown",
              "text": "$H(x)=17.44(1.03)^{2\\left(x-1\\right)}$"
            }
          ]
        },
        {
          "id": "choice-b",
          "content": [
            {
              "type": "markdown",
              "text": "$H(x)=17.44(1.03)^{6\\left(x-1\\right)}$"
            }
          ]
        },
        {
          "id": "choice-c",
          "content": [
            {
              "type": "markdown",
              "text": "$H(x)=17.44(1.03)^{\\frac{1}{6}\\left(x-1\\right)}$"
            }
          ]
        },
        {
          "id": "choice-d",
          "content": [
            {
              "type": "markdown",
              "text": "$H(x)=17.44(1.03)^{\\frac{1}{2}\\left(x-1\\right)}$"
            }
          ]
        }
      ]
    },
