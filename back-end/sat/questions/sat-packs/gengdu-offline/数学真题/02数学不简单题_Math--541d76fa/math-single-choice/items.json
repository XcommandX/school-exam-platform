      "prompt": [
        {
          "type": "markdown",
          "text": "7x+4y=3  \n\n35x+20y=15  \n\nFor each real number *r*, which of the following points lies on the graph of each equation in the xy-plane for the given system?"
        }
      ],
      "source": {
        "kind": "gengdu-export",
        "sourceSetId": "gengdu-offline-541d76faa8734bac8f43ebffca82e9ca",
        "sourceQuestionId": "9370573",
        "url": "https://gengdu.shanmaostar.com"
      },
      "options": [
        {
          "id": "choice-a",
          "content": [
