  "items": [
    {
      "id": "sat:item:gengdu-gengdu-offline-15a351207536453a88fa932d05458a81-8900465",
      "revision": 1,
      "classification": {
        "skill": "Unclassified"
      },
      "content": [],
      "prompt": [
        {
          "type": "markdown",
          "text": "Jennifer bought a box of Crunchy Grain cereal. The nutrition facts on the box state that a serving size of the cereal is $\\frac{3}{4}$  cup and provides 210 calories, 50 of which are calories from fat. In addition, each serving of the cereal provides 180 milligrams of potassium, which is 5% of the daily allowance for adults. If *p* percent of an adult’s daily allowance of potassium is provided by *x* servings of Crunchy Grain cereal per day, which of the following expresses *p* in terms of *x* ?"
        }
      ],
      "source": {
        "kind": "gengdu-export",
        "sourceSetId": "gengdu-offline-15a351207536453a88fa932d05458a81",
        "sourceQuestionId": "8900465",
        "url": "https://gengdu.shanmaostar.com"
      },
      "options": [
        {
          "id": "choice-a",
          "content": [
            {
              "type": "markdown",
              "text": "*p* = 0.05*x*"
            }
          ]
        },
        {
          "id": "choice-b",
          "content": [
            {
              "type": "markdown",
              "text": "*p* = 5*x*"
            }
          ]
        },
        {
          "id": "choice-c",
          "content": [
            {
              "type": "markdown",
              "text": "*p* = (0.05)$^{x}$"
            }
          ]
        },
        {
          "id": "choice-d",
          "content": [
            {
              "type": "markdown",
              "text": "*p* = (1.05)$^{x}$"
            }
          ]
        }
      ]
    },
