{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "school-exam-platform",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-10-20",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "ai": { "binding": "AI", "remote": true },
  "vars": {
    "ENABLE_AI": "true",
    "ASSESSMENT_PROVIDER": "cloudflare",
    "TEXT_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast"
  },
  "assets": {
    "directory": "../../local-data/builds/cloudflare/assets",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "durable_objects": {
    "bindings": [
      {"name": "AUTH", "class_name": "PlatformAuthStore"},
      {"name": "ACCOUNTS", "class_name": "PlatformAccountStore"},
      {"name": "BANK", "class_name": "PlatformBankStore"}
    ]
  },
  "migrations": [{
    "tag": "v1",
    "new_sqlite_classes": ["PlatformAuthStore", "PlatformAccountStore", "PlatformBankStore"]
  }],
  "observability": {"enabled": false}
}
