{
  "name": "school-exam-platform-cloudflare",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "test:browser": "node tests/browser-smoke.mjs",
    "test:registration-browser": "node tests/registration-browser.mjs",
    "dev": "wrangler dev --config wrangler.jsonc --ip 127.0.0.1",
    "deploy": "wrangler deploy --config wrangler.jsonc"
  },
  "overrides": { "undici": "7.30.1" },
  "devDependencies": {
    "wrangler": "4.152.0",
    "miniflare": "5.20261019.2-beta",
    "esbuild": "0.28.2"
  },
  "dependencies": {
    "@noble/hashes": "2.0.1"
  }
}
