            "type": "text",
            "text": "The function increases by 2 when x increases by 1, so f(x)=2x+1 and f(4)=9."
          }
        ],
        "steps": [
          {
            "id": "table-step-1",
            "content": [
              {
                "type": "math",
                "latex": "m=(3-1)/(1-0)=2",
                "spokenText": "slope equals two"
              }
            ]
          },
          {
            "id": "table-step-2",
            "content": [
              {
                "type": "math",
                "latex": "f(4)=2(4)+1=9",
                "spokenText": "f of four equals nine"
              }
            ]
          }
        ],
        "optionFeedback": [
          {
            "optionId": "sat:interaction:table:A",
            "content": [
              {
                "type": "text",
                "text": "7 is f(3), rather than f(4)."
              }
            ]
          },
          {
            "optionId": "sat:interaction:table:B",
            "content": [
              {
                "type": "text",
                "text": "8 omits the intercept of 1."
              }
            ]
          },
          {
            "optionId": "sat:interaction:table:D",
            "content": [
              {
                "type": "text",
                "text": "10 does not follow the table’s constant increase of 2."
              }
            ]
          }
