        "content": [
          {
            "type": "text",
            "text": "Use one perpendicular leg as the base and the other as the height. The area is half the product, or 12 square units."
          }
        ],
        "steps": [
          {
            "id": "area-step-1",
            "content": [
              {
                "type": "math",
                "latex": "A=\\frac{1}{2}bh",
                "spokenText": "Area is one half base times height"
              }
            ]
          },
          {
            "id": "area-step-2",
            "content": [
              {
                "type": "math",
                "latex": "A=\\frac{1}{2}\\cdot6\\cdot4=12",
                "spokenText": "Area equals twelve square units"
              }
            ]
          }
        ],
        "optionFeedback": [
          {
            "optionId": "sat:interaction:geometry:A",
            "content": [
              {
                "type": "text",
                "text": "10 is the sum of the leg lengths, not an area."
              }
            ]
          },
          {
            "optionId": "sat:interaction:geometry:C",
            "content": [
              {
                "type": "text",
                "text": "20 is not half the product of the two perpendicular lengths."
              }
            ]
          },
          {
            "optionId": "sat:interaction:geometry:D",
            "content": [
              {
                "type": "text",
                "text": "24 omits the factor of one half."
              }
            ]
